# Copy this file to .env and fill in your real values. Never commit .env.

AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-5.4"        # the deployment name YOU chose in Azure, not a model name
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# The frontend origin allowed to call this API (CORS). Defaults to the
# Vite dev server if unset.
FRONTEND_ORIGIN="http://localhost:5173"
